{
  "name": "@leadrails/next",
  "version": "0.1.2",
  "description": "Next.js adapter for @leadrails/sdk. createLeadEventRoute + createLeadEventAction + ESLint lint preset.",
  "license": "MIT",
  "author": "Austin Lowther <dev@austin.lowther.me>",
  "homepage": "https://leadrails.dev/?ref=npm",
  "repository": {
    "type": "git",
    "url": "https://github.com/leadrails/sdk.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/leadrails/sdk/issues"
  },
  "keywords": [
    "leadrails",
    "next",
    "nextjs",
    "route-handler",
    "server-action",
    "hmac",
    "webhook"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lint/oxlint": "./src/lint/oxlint.ts",
    "./lint/eslint": "./src/lint/eslint.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/browser-stub.js",
        "node": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./lint/oxlint": {
        "types": "./dist/lint/oxlint.d.ts",
        "default": "./dist/lint/oxlint.js"
      },
      "./lint/eslint": {
        "types": "./dist/lint/eslint.d.ts",
        "default": "./dist/lint/eslint.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp ../sdk/src/browser-stub.js dist/browser-stub.js",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@leadrails/sdk": "0.1.1",
    "next": ">=13.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    }
  },
  "dependencies": {
    "@leadrails/sdk": "0.1.1",
    "server-only": "^0.0.1"
  }
}
