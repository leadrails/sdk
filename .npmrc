# pnpm 9 changed the default to false. We want plain-range deps
# (e.g. "0.1.2-rc.0") to resolve to the workspace package whenever
# the workspace version satisfies the range. This lets us write
# JSR-compatible literal version ranges in package.json without
# losing pnpm's workspace-linking convenience.
#
# See AGENTS.md → "JSR-specific facts that bit us" for why we can't
# use the workspace: protocol in published dependency fields.
link-workspace-packages=true
